#!/usr/bin/env bash
# install_name_tool via LLVM, then repair the layout dyld insists on (see
# tools/macho-align.py).
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
# install_name_tool's syntax puts the image last, after every option and its
# values (`install_name_tool [-id NAME] [-change OLD NEW] ... FILE`), and the
# edit is in place, so the last argument is the file just rewritten.
if command -v llvm-install-name-tool >/dev/null; then llvm-install-name-tool "$@"; else python3 "$here/install_name_tool.py" "$@"; fi
python3 "$here/../../flutter/tools/macho-align.py" "${*: -1}"
