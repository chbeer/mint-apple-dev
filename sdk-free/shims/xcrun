#!/usr/bin/env bash
# Stand-in for Apple's xcrun for the SDK-free mode: every SDK query answers with the SDK-free sysroot, tool
# invocations go to LLVM equivalents. Set XCRUN_SHIM_LOG to record calls.
here=$(dirname "$(readlink -f "$0")")
SDKFREE_HOME=${SDKFREE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/mint-apple-dev/sdk-free}
SR=${NOSDK_SYSROOT:-$SDKFREE_HOME/iPhoneOS.sdk}
[ -z "${XCRUN_SHIM_LOG:-}" ] || echo "xcrun $*" >>"$XCRUN_SHIM_LOG"

sdk=iphoneos
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --sdk | -sdk) sdk=$2; shift 2 ;;
    --show-sdk-path) echo "$SR"; exit 0 ;;
    --show-sdk-version | --show-sdk-platform-version)
      python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["Version"])' "$SR/SDKSettings.json"
      exit 0 ;;
    --find | -f)
      case "$2" in clang | clang++ | cc) echo "$here/clang-darwin"; exit 0 ;; esac
      for c in "$here/$2" "llvm-$2" "$2"; do
        if p=$(command -v "$c"); then echo "$p"; exit 0; fi
      done
      exit 1 ;;
    *) args+=("$1"); shift ;;
  esac
done
[ ${#args[@]} -gt 0 ] || exit 0

tool=${args[0]}
rest=("${args[@]:1}")
case "$tool" in
  clang | clang++ | cc) exec "$here/clang-darwin" "${rest[@]}" ;;
  codesign) exit 0 ;;
  *)
    if [ -x "$here/$tool" ]; then exec "$here/$tool" "${rest[@]}"; fi
    if command -v "llvm-${tool//_/-}" >/dev/null; then exec "llvm-${tool//_/-}" "${rest[@]}"; fi
    exec "$tool" "${rest[@]}" ;;
esac
