#!/usr/bin/env python3
"""Minimal otool for the SDK-free mode: -D (install name) and -L (load commands' libraries) on thin or fat Mach-O.
Anything else goes to llvm-otool when it exists."""
import os
import shutil
import struct
import sys

LC_LOAD_DYLIB, LC_ID_DYLIB, LC_LOAD_WEAK_DYLIB, LC_REEXPORT_DYLIB = 0xC, 0xD, 0x80000018, 0x8000001F


def thin_slice(d):
    magic = struct.unpack_from(">I", d, 0)[0]
    if magic in (0xCAFEBABE, 0xCAFEBABF):
        n = struct.unpack_from(">I", d, 4)[0]
        for i in range(n):
            if magic == 0xCAFEBABE:
                cpu, _s, off, size, _a = struct.unpack_from(">iiIII", d, 8 + 20 * i)
            else:
                cpu, _s, off, size, _a = struct.unpack_from(">iiQQI", d, 8 + 32 * i)
            if cpu & 0xFFFFFFFF == 0x0100000C:
                return d[off:off + size]
        return d[struct.unpack_from(">I", d, 16)[0]:]
    return d


def commands(d):
    ncmds = struct.unpack_from("<I", d, 16)[0]
    off = 32
    for _ in range(ncmds):
        cmd, size = struct.unpack_from("<II", d, off)
        yield cmd, d[off:off + size]
        off += size


def dylib_name(blob):
    name_off = struct.unpack_from("<I", blob, 8)[0]
    return blob[name_off:].split(b"\0", 1)[0].decode()


args = sys.argv[1:]
flags = [a for a in args if a.startswith("-")]
files = [a for a in args if not a.startswith("-")]
if flags in (["-D"], ["-L"]) and files:
    for path in files:
        with open(path, "rb") as f:
            d = thin_slice(f.read())
        print(f"{path}:")
        for cmd, blob in commands(d):
            if flags == ["-D"] and cmd == LC_ID_DYLIB:
                print(dylib_name(blob))
            if flags == ["-L"] and cmd in (LC_ID_DYLIB, LC_LOAD_DYLIB, LC_LOAD_WEAK_DYLIB, LC_REEXPORT_DYLIB):
                print("\t" + dylib_name(blob) + " (compatibility version 1.0.0, current version 1.0.0)")
    sys.exit(0)
exe = shutil.which("llvm-otool")
if exe:
    os.execv(exe, [exe] + args)
sys.exit("otool shim: unsupported arguments: " + " ".join(args))
